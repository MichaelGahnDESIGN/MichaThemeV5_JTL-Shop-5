<?xml version="1.0" encoding="UTF-8"?>
<jtlshopplugin>
    <Name>MGD Notification Center</Name>
    <Description>Öffentliche und persönliche Benachrichtigungen (Glocke) für MichaThemeV5.</Description>
    <Author>Michael Gahn DESIGN</Author>
    <URL>https://github.com/MichaelGahnDESIGN/MichaThemeV5_JTL-Shop-5</URL>
    <PluginID>MichaThemeV5NotificationCenter</PluginID>
    <XMLVersion>102</XMLVersion>
    <ShopVersion>5.8.0</ShopVersion>
    <CreateDate>2026-10-23</CreateDate>
    <Version>0.2.1</Version>
    <Install>
        <FlushTags>CACHING_GROUP_TEMPLATE,CACHING_GROUP_PLUGIN</FlushTags>
        <Adminmenu>
            <Customlink sort="1">
                <Name>Übersicht</Name>
                <Filename>uebersicht.php</Filename>
            </Customlink>
            <Customlink sort="2">
                <Name>Updates</Name>
                <Filename>updates.php</Filename>
            </Customlink>
        </Adminmenu>
    </Install>
</jtlshopplugin>
